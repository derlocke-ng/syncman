#!/usr/bin/env python3
"""syncman-panel — GTK4/libadwaita panel for syncman (GNOME 40+).

Feature-parity port of the original syncman panel onto the debloated
backend: plain .job files ("src :: dst" lines) instead of YAML/yq, one
syncjob@ template unit instead of generated unit files, user scope only.
"""
import os
import re
import shutil
import signal
import socket
import subprocess
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Gtk, Adw, GLib, Gio  # noqa: E402

APP_ID = "eu.kiwinetwork.Syncman"
REFRESH_MS = 5000
HOSTNAME = socket.gethostname()

CONF_DIR = os.path.join(GLib.get_user_config_dir(), "syncman")
CONF_FILE = os.path.join(CONF_DIR, "syncman.conf")


# ── backend helpers ──────────────────────────────────────────────────────────

def find_cli():
    for c in (shutil.which("syncman"),
              os.path.expanduser("~/.local/bin/syncman"),
              os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "bin", "syncman")):
        if c and os.path.exists(c):
            return os.path.realpath(c)
    return None


def run(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "timeout"
    except Exception as e:  # noqa: BLE001
        return 1, "", str(e)


def conf_get(key, default):
    try:
        with open(CONF_FILE) as fh:
            for line in fh:
                if line.startswith(f"{key}="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return default


def conf_set(key, value):
    os.makedirs(CONF_DIR, exist_ok=True)
    lines, found = [], False
    try:
        with open(CONF_FILE) as fh:
            lines = fh.readlines()
    except OSError:
        pass
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = f"{key}={value}\n"
            found = True
    if not found:
        lines.append(f"{key}={value}\n")
    with open(CONF_FILE, "w") as fh:
        fh.writelines(lines)


def jobs_dir():
    return os.path.expanduser(conf_get("JOBS_DIR", os.path.join(CONF_DIR, "jobs")))


def parse_pairs(fpath):
    """Pairs from a .job file — same rules as the syncjob worker."""
    pairs = []
    try:
        with open(fpath) as fh:
            for line in fh:
                line = line.split("#", 1)[0]
                if " :: " not in line:
                    continue
                src, dst = line.split(" :: ", 1)
                pairs.append((src.strip(), dst.strip()))
    except OSError:
        pass
    return pairs


def get_jobs():
    jobs = []
    d = jobs_dir()
    try:
        names = sorted(f[:-4] for f in os.listdir(d) if f.endswith(".job"))
    except OSError:
        return jobs
    for name in names:
        fpath = os.path.join(d, f"{name}.job")
        unit = f"syncjob@{name}.service"
        _, active, _ = run(["systemctl", "--user", "is-active", unit], timeout=5)
        _, enabled, _ = run(["systemctl", "--user", "is-enabled", unit], timeout=5)
        jobs.append({
            "name": name,
            "file": fpath,
            "pairs": parse_pairs(fpath),
            "active": active == "active",
            "enabled": enabled == "enabled",
        })
    return jobs


def shorten(path, maxlen=38):
    return path if len(path) <= maxlen else "…" + path[-(maxlen - 1):]


def status_attrs(j):
    if j["active"]:
        return "active", "media-playback-start-symbolic", "success"
    if j["enabled"]:
        return "enabled (inactive)", "media-playback-pause-symbolic", "warning"
    return "stopped", "media-playback-stop-symbolic", "dim-label"


JOB_SKELETON = """\
# syncman job — one pair per line, separated by " :: "
# newer files win in both directions; nothing is ever deleted.
#/path/to/source :: /path/to/destination
"""


# ── main window ──────────────────────────────────────────────────────────────

class SyncmanWindow(Adw.ApplicationWindow):
    def __init__(self, app, cli):
        super().__init__(application=app, title="syncman")
        self.cli = cli
        self.set_default_size(620, 740)
        self._busy = False
        self._job_rows: dict = {}
        self._selected: dict = {}   # name -> checked
        self._build()
        self._refresh()
        GLib.timeout_add(REFRESH_MS, self._auto_refresh)

    # ── layout ────────────────────────────────────────────────────────────
    def _build(self):
        root = Adw.ToolbarView()
        self.set_content(root)

        hdr = Adw.HeaderBar()
        hdr.set_title_widget(Adw.WindowTitle(title="syncman", subtitle="sync manager"))
        btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        btn_refresh.connect("clicked", lambda *_: self._refresh())
        hdr.pack_end(btn_refresh)
        root.add_top_bar(hdr)

        scroll = Gtk.ScrolledWindow(vexpand=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.set_content(scroll)
        page = Adw.PreferencesPage()
        scroll.set_child(page)

        # ── configuration ────────────────────────────────────────────────
        cfg_grp = Adw.PreferencesGroup(title="Configuration")
        page.add(cfg_grp)

        interval_row = Adw.ActionRow(title="Sync Interval",
                                     subtitle="Seconds between sync passes")
        self._spin = Gtk.SpinButton(
            adjustment=Gtk.Adjustment(value=int(conf_get("INTERVAL", "30")),
                                      lower=1, upper=3600,
                                      step_increment=1, page_increment=10),
            valign=Gtk.Align.CENTER, width_chars=5)
        save_btn = Gtk.Button(label="Save", valign=Gtk.Align.CENTER)
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", self._save_interval)
        interval_row.add_suffix(self._spin)
        interval_row.add_suffix(save_btn)
        cfg_grp.add(interval_row)

        folder_row = Adw.ActionRow(title="Jobs Folder", subtitle=jobs_dir())
        open_btn = Gtk.Button(icon_name="folder-open-symbolic",
                              valign=Gtk.Align.CENTER, tooltip_text="Open jobs folder")
        open_btn.connect("clicked", self._open_folder)
        folder_row.add_suffix(open_btn)
        cfg_grp.add(folder_row)
        self._folder_row = folder_row

        # ── new job ───────────────────────────────────────────────────────
        new_grp = Adw.PreferencesGroup(title="New Sync Job")
        page.add(new_grp)
        new_row = Adw.ActionRow(title="Job Name",
                                subtitle="Letters, digits, hyphens, underscores")
        self._name_entry = Gtk.Entry(placeholder_text="e.g. game-saves",
                                     hexpand=True, valign=Gtk.Align.CENTER)
        self._name_entry.connect("activate", lambda *_: self._create_job())
        create_btn = Gtk.Button(label="Create", valign=Gtk.Align.CENTER)
        create_btn.add_css_class("suggested-action")
        create_btn.connect("clicked", lambda *_: self._create_job())
        new_row.add_suffix(self._name_entry)
        new_row.add_suffix(create_btn)
        new_grp.add(new_row)

        # ── jobs ──────────────────────────────────────────────────────────
        self._jobs_grp = Adw.PreferencesGroup(title="Sync Jobs")
        hdr_btns = Gtk.Box(spacing=8)
        sa = Gtk.Button(label="Start Selected")
        sa.add_css_class("suggested-action")
        sa.connect("clicked", lambda *_: self._bulk("start"))
        sto = Gtk.Button(label="Stop Selected")
        sto.add_css_class("destructive-action")
        sto.connect("clicked", lambda *_: self._bulk("stop"))
        hdr_btns.append(sa)
        hdr_btns.append(sto)
        self._jobs_grp.set_header_suffix(hdr_btns)
        page.add(self._jobs_grp)

        # ── status bar ────────────────────────────────────────────────────
        self._status_lbl = Gtk.Label(label="", xalign=0, margin_start=16,
                                     margin_end=16, margin_top=4, margin_bottom=4)
        self._status_lbl.add_css_class("caption")
        self._status_lbl.add_css_class("dim-label")
        root.add_bottom_bar(self._status_lbl)

    # ── helpers ────────────────────────────────────────────────────────────
    def _set_status(self, text):
        self._status_lbl.set_label(text)

    def _status(self, text):
        GLib.idle_add(self._set_status, text)

    def _open_folder(self, *_):
        d = jobs_dir()
        os.makedirs(d, exist_ok=True)
        Gio.AppInfo.launch_default_for_uri(f"file://{d}", None)

    def _auto_refresh(self):
        if not self._busy:
            self._refresh()
        return GLib.SOURCE_CONTINUE

    # ── refresh — diff-based, expanders stay open ──────────────────────────
    def _refresh(self):
        threading.Thread(target=lambda: GLib.idle_add(self._populate, get_jobs()),
                         daemon=True).start()

    def _populate(self, jobs):
        new_names = [j["name"] for j in jobs]
        for name in set(self._job_rows) - set(new_names):
            self._jobs_grp.remove(self._job_rows[name]["expander"])
            del self._job_rows[name]
        for j in jobs:
            if j["name"] in self._job_rows:
                self._update_job_row(j)
            else:
                rd = self._make_job_row(j)
                self._jobs_grp.add(rd["expander"])
                self._job_rows[j["name"]] = rd
        n = len(jobs)
        active = sum(1 for j in jobs if j["active"])
        self._set_status(f"{n} sync job{'s' if n != 1 else ''} · {active} running"
                         if n else "No jobs yet — create one above.")
        self._folder_row.set_subtitle(jobs_dir())
        return False

    def _subtitle(self, j):
        status_str, _, _ = status_attrs(j)
        n = len(j["pairs"])
        local = "  ·  this device" if j["name"].endswith(f"-{HOSTNAME}") else ""
        return f"{status_str}  ·  {n} pair{'s' if n != 1 else ''}{local}"

    def _make_job_row(self, j):
        status_str, icon, css = status_attrs(j)
        expander = Adw.ExpanderRow(title=j["name"], subtitle=self._subtitle(j),
                                   icon_name=icon)

        # checkbox for selective start/stop; this device's jobs pre-checked
        check = Gtk.CheckButton()
        if j["name"] not in self._selected:
            self._selected[j["name"]] = j["name"].endswith(f"-{HOSTNAME}")
        check.set_active(self._selected[j["name"]])
        check.connect("toggled", lambda c, n=j["name"]: self._selected.__setitem__(n, c.get_active()))
        expander.add_prefix(check)

        badge = Gtk.Label(label=status_str, valign=Gtk.Align.CENTER)
        badge.add_css_class("caption")
        badge.add_css_class(css)
        expander.add_suffix(badge)

        pair_rows = self._build_pair_rows(j["pairs"])
        for pr in pair_rows:
            expander.add_row(pr)
        action_row, btn_stack = self._build_action_row(j)
        expander.add_row(action_row)

        return {"expander": expander, "check": check, "badge": badge,
                "btn_stack": btn_stack, "pairs": list(j["pairs"]),
                "pair_rows": pair_rows, "action_row": action_row}

    def _build_pair_rows(self, pairs):
        if not pairs:
            return [Adw.ActionRow(title="No pairs configured",
                                  subtitle="Use 'Add Pair' to set sync paths",
                                  selectable=False)]
        return [Adw.ActionRow(title=shorten(src), subtitle=f"↔  {shorten(dst)}",
                              selectable=False)
                for src, dst in pairs]

    def _build_action_row(self, j):
        action_row = Adw.ActionRow(selectable=False)
        box = Gtk.Box(spacing=8, valign=Gtk.Align.CENTER, hexpand=True,
                      margin_top=6, margin_bottom=6)

        btn_stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                              transition_duration=80)
        start_btn = Gtk.Button(label="Start")
        start_btn.add_css_class("suggested-action")
        start_btn.connect("clicked", lambda _, n=j["name"]: self._job_action("start", n))
        stop_btn = Gtk.Button(label="Stop")
        stop_btn.add_css_class("destructive-action")
        stop_btn.connect("clicked", lambda _, n=j["name"]: self._job_action("stop", n))
        btn_stack.add_named(start_btn, "start")
        btn_stack.add_named(stop_btn, "stop")
        btn_stack.set_visible_child_name("stop" if j["active"] else "start")
        box.append(btn_stack)

        sync_btn = Gtk.Button(label="Sync Now")
        sync_btn.connect("clicked", lambda _, n=j["name"]: self._job_action("sync", n))
        box.append(sync_btn)

        log_btn = Gtk.Button(label="Log")
        log_btn.connect("clicked", lambda _, n=j["name"]: self._show_log(n))
        box.append(log_btn)

        add_btn = Gtk.Button(label="Add Pair")
        add_btn.connect("clicked", lambda _, n=j["name"], f=j["file"]: self._add_pair(n, f))
        box.append(add_btn)

        edit_btn = Gtk.Button(label="Edit")
        edit_btn.connect("clicked", lambda _, f=j["file"]: self._edit_file(f))
        box.append(edit_btn)

        box.append(Gtk.Box(hexpand=True))  # spacer

        del_btn = Gtk.Button(label="Delete")
        del_btn.add_css_class("destructive-action")
        del_btn.connect("clicked", lambda _, n=j["name"], f=j["file"]: self._delete_job(n, f))
        box.append(del_btn)

        action_row.add_suffix(box)
        return action_row, btn_stack

    def _update_job_row(self, j):
        rd = self._job_rows[j["name"]]
        status_str, icon, css = status_attrs(j)
        rd["expander"].set_subtitle(self._subtitle(j))
        rd["expander"].set_icon_name(icon)
        badge = rd["badge"]
        badge.set_label(status_str)
        for c in ("success", "warning", "dim-label"):
            badge.remove_css_class(c)
        badge.add_css_class(css)
        rd["btn_stack"].set_visible_child_name("stop" if j["active"] else "start")

        if list(j["pairs"]) != rd["pairs"]:
            expander = rd["expander"]
            for pr in rd["pair_rows"]:
                expander.remove(pr)
            expander.remove(rd["action_row"])
            rd["pair_rows"] = self._build_pair_rows(j["pairs"])
            for pr in rd["pair_rows"]:
                expander.add_row(pr)
            expander.add_row(rd["action_row"])
            rd["pairs"] = list(j["pairs"])

    # ── config / create ─────────────────────────────────────────────────────
    def _save_interval(self, *_):
        secs = int(self._spin.get_value())
        try:
            conf_set("INTERVAL", secs)
            self._set_status(f"Interval set to {secs}s — restart jobs to apply.")
        except Exception as e:  # noqa: BLE001
            self._set_status(f"Failed: {e}")

    def _create_job(self):
        name = self._name_entry.get_text().strip()
        if not name:
            self._set_status("Enter a job name.")
            return
        if not re.match(r"^[A-Za-z0-9._-]+$", name):
            self._set_status("Name must be alphanumeric (a-z, 0-9, ., -, _).")
            return
        fpath = os.path.join(jobs_dir(), f"{name}.job")
        if os.path.exists(fpath):
            self._set_status(f"Job '{name}' already exists.")
            return
        try:
            os.makedirs(jobs_dir(), exist_ok=True)
            with open(fpath, "w") as fh:
                fh.write(JOB_SKELETON)
            self._name_entry.set_text("")
            self._set_status(f"Job '{name}' created — add pairs now.")
        except Exception as e:  # noqa: BLE001
            self._set_status(f"Failed: {e}")
        self._refresh()

    # ── job actions (via the CLI — single source of behavior) ───────────────
    def _job_action(self, verb, name):
        if self._busy:
            return
        self._busy = True
        self._status(f"{verb} '{name}'…")

        def worker():
            rc, out, err = run([self.cli, verb, name], timeout=120)
            GLib.idle_add(self._action_done, rc,
                          f"'{name}' {verb} done." if rc == 0 else f"{verb} failed: {err or out}")
        threading.Thread(target=worker, daemon=True).start()

    def _action_done(self, rc, msg):
        self._busy = False
        self._set_status(msg)
        self._refresh()
        return False

    def _bulk(self, verb):
        if self._busy:
            return
        names = [n for n, v in self._selected.items() if v] or list(self._job_rows)
        if not names:
            return
        self._busy = True
        self._status(f"{verb} {len(names)} job(s)…")

        def worker():
            failed = [n for n in names if run([self.cli, verb, n], timeout=60)[0] != 0]
            ok = len(names) - len(failed)
            msg = (f"{len(names)} job(s) {verb}ed." if not failed
                   else f"{ok}/{len(names)} {verb}ed, {len(failed)} failed: {', '.join(failed)}")
            GLib.idle_add(self._action_done, len(failed), msg)
        threading.Thread(target=worker, daemon=True).start()

    # ── log window ──────────────────────────────────────────────────────────
    def _show_log(self, name):
        _, out, err = run(["journalctl", "--user", "-u", f"syncjob@{name}.service",
                           "-n", "80", "--no-pager"], timeout=10)
        win = Adw.Window(title=f"Log — {name}", transient_for=self, modal=True)
        win.set_default_size(700, 460)
        tb = Adw.ToolbarView()
        win.set_content(tb)
        h = Adw.HeaderBar()
        h.set_title_widget(Adw.WindowTitle(title=f"Log — {name}"))
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: win.close())
        h.pack_end(close)
        tb.add_top_bar(h)
        sc = Gtk.ScrolledWindow()
        tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.NONE,
                          margin_start=10, margin_end=10, margin_top=8, margin_bottom=8)
        tv.get_buffer().set_text(out or err or "(no log output)")
        sc.set_child(tv)
        tb.set_content(sc)
        win.present()

    # ── add pair (two folder pickers, like the original) ────────────────────
    def _add_pair(self, name, fpath):
        c1 = Gtk.FileChooserNative(title=f"Source folder for '{name}'",
                                   transient_for=self,
                                   action=Gtk.FileChooserAction.SELECT_FOLDER)
        c1.connect("response", self._on_src_chosen, name, fpath)
        c1.show()
        self._c1 = c1   # keep a ref, FileChooserNative is GC-sensitive

    def _on_src_chosen(self, chooser, response, name, fpath):
        if response != Gtk.ResponseType.ACCEPT:
            return
        src = chooser.get_file().get_path()
        c2 = Gtk.FileChooserNative(title=f"Destination folder for '{name}'",
                                   transient_for=self,
                                   action=Gtk.FileChooserAction.SELECT_FOLDER)
        c2.connect("response", self._on_dst_chosen, name, fpath, src)
        c2.show()
        self._c2 = c2

    def _on_dst_chosen(self, chooser, response, name, fpath, src):
        if response != Gtk.ResponseType.ACCEPT:
            return
        dst = chooser.get_file().get_path()
        try:
            with open(fpath, "a") as fh:
                fh.write(f"{src} :: {dst}\n")
            self._set_status(f"Pair added to '{name}'.")
        except Exception as e:  # noqa: BLE001
            self._set_status(f"Failed: {e}")
        self._refresh()

    # ── edit job file in-app ────────────────────────────────────────────────
    def _edit_file(self, fpath):
        try:
            with open(fpath) as fh:
                content = fh.read()
        except Exception as e:  # noqa: BLE001
            self._set_status(f"Cannot read: {e}")
            return
        win = Adw.Window(title=f"Edit — {os.path.basename(fpath)}",
                         transient_for=self, modal=True)
        win.set_default_size(560, 380)
        tb = Adw.ToolbarView()
        win.set_content(tb)
        h = Adw.HeaderBar()
        h.set_title_widget(Adw.WindowTitle(title=os.path.basename(fpath)))
        tb.add_top_bar(h)
        sc = Gtk.ScrolledWindow()
        tv = Gtk.TextView(monospace=True, wrap_mode=Gtk.WrapMode.NONE,
                          margin_start=10, margin_end=10, margin_top=8, margin_bottom=8)
        tv.get_buffer().set_text(content)
        sc.set_child(tv)
        tb.set_content(sc)

        def _save(*_):
            buf = tv.get_buffer()
            text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), True)
            try:
                with open(fpath, "w") as fh:
                    fh.write(text)
                self._set_status(f"Saved {os.path.basename(fpath)}.")
            except Exception as e:  # noqa: BLE001
                self._set_status(f"Save failed: {e}")
            win.close()
            self._refresh()

        save_btn = Gtk.Button(label="Save")
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", _save)
        h.pack_end(save_btn)
        win.present()

    # ── delete job ──────────────────────────────────────────────────────────
    def _delete_job(self, name, fpath):
        dlg = Adw.AlertDialog(heading=f"Delete '{name}'?",
                              body="This stops the service and removes the job file.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("delete", "Delete")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")
        dlg.connect("response", self._on_delete_response, name, fpath)
        dlg.present(self)

    def _on_delete_response(self, _dlg, response, name, fpath):
        if response != "delete":
            return
        run([self.cli, "stop", name], timeout=30)
        try:
            os.remove(fpath)
        except FileNotFoundError:
            pass
        self._selected.pop(name, None)
        self._set_status(f"Job '{name}' deleted.")
        self._refresh()


# ── application ──────────────────────────────────────────────────────────────

class SyncmanApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            cli = find_cli()
            if not cli:
                raise SystemExit("syncman CLI not found — install syncman first")
            win = SyncmanWindow(self, cli)
        win.present()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    raise SystemExit(SyncmanApp().run(None))
