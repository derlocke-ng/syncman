ICON_STYLES = [("classic", "Classic"), ("flat", "Flat"), ("night", "Night")]


def icon_colors():
    """(key, label): the stock icon first, then every kiwi-icons colourway."""
    out = [("", "Syncman's own")]
    if kiwi_icon is not None:
        out += [(k, v["label"]) for k, v in kiwi_icon.COLORWAYS.items()]
    return out


def custom_icons():
    """Your own icons: PNG or SVG files in ICONS_DIR."""
    try:
        names = sorted(os.listdir(ICONS_DIR))
    except OSError:
        return []
    return [f for f in names
            if f.lower().endswith((".svg", ".png")) and os.path.isfile(os.path.join(ICONS_DIR, f))]


def apply_icon():
    """Put the icon syncman.conf asks for where the desktop entry finds it.
    ICON_FILE (one of your own) wins; else the cloud kiwi in ICON_COLOR and
    ICON_STYLE; with neither set, the stock icon install.sh put there stays.
    Returns an error message, or None."""
    own = conf_get("ICON_FILE", "")
    color = conf_get("ICON_COLOR", "")
    style = conf_get("ICON_STYLE", "classic")
    apps = os.path.join(HICOLOR, "scalable", "apps")
    target = os.path.join(apps, f"{APP_ID}.svg")
    try:
        os.makedirs(apps, exist_ok=True)
        if own:
            src = os.path.join(ICONS_DIR, own)
            if own.lower().endswith(".png"):
                # a PNG under a .svg name would not load; wrap it instead
                import base64
                with open(src, "rb") as fh:
                    data = base64.b64encode(fh.read()).decode()
                svg = ('<svg xmlns="http://www.w3.org/2000/svg" '
                       'xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 128 128" '
                       f'width="128" height="128"><image width="128" height="128" '
                       f'xlink:href="data:image/png;base64,{data}"/></svg>\n')
            else:
                with open(src) as fh:
                    svg = fh.read()
        elif color or style != "classic":
            if kiwi_icon is None:
                return "kiwi_icon.py is missing — reinstall syncman"
            svg = kiwi_icon.render(ICON_GLYPH, colorway=color or None, style=style,
                                   title="syncman")
        else:
            stock = stock_icon()
            if stock is None:
                return None
            with open(stock) as fh:
                svg = fh.read()
        with open(target + ".tmp", "w") as fh:
            fh.write(svg)
        os.replace(target + ".tmp", target)
    except (OSError, ValueError) as e:
        return str(e)
    if shutil.which("gtk-update-icon-cache"):
        run(["gtk-update-icon-cache", "-qtf", HICOLOR], timeout=20)
    return None


def stock_icon():
    """data/syncman.svg as install.sh keeps it, or from the source tree."""
    for c in (os.path.join(_here, "..", "share", "syncman", "syncman.svg"),
              os.path.join(_here, "..", "data", "syncman.svg")):
        if os.path.isfile(c):
            return c
    return None


def jobs_dir():
    return os.path.expanduser(conf_get("JOBS_DIR", os.path.join(CONF_DIR, "jobs")))


def parse_pairs(fpath):
    """Pairs from a .job file — same rules as the syncjob worker."""
    pairs = []
    try:
        with open(fpath) as fh:
            for line in fh:
                line = line.split("#", 1)[0]
                if " :: " not in line:
                    continue
                src, dst = line.split(" :: ", 1)
                pairs.append((os.path.expanduser(src.strip()), os.path.expanduser(dst.strip())))
    except OSError:
        pass
    return pairs


def get_jobs():
    jobs = []
    d = jobs_dir()
    try:
        names = sorted(f[:-4] for f in os.listdir(d) if f.endswith(".job"))
    except OSError:
        return jobs
    for name in names:
        fpath = os.path.join(d, f"{name}.job")
        unit = f"syncjob@{name}.service"
        _, active, _ = run(["systemctl", "--user", "is-active", unit], timeout=5)
        _, enabled, _ = run(["systemctl", "--user", "is-enabled", unit], timeout=5)
        jobs.append({
            "name": name,
            "file": fpath,
            "pairs": parse_pairs(fpath),
            "active": active == "active",
            "enabled": enabled == "enabled",
        })
    return jobs


HOME = os.path.expanduser("~")


def shorten(path, maxlen=60):
    if path == HOME or path.startswith(HOME + os.sep):
        path = "~" + path[len(HOME):]
    return path if len(path) <= maxlen else "…" + path[-(maxlen - 1):]


def status_attrs(j):
    if j["active"]:
        return "active", "media-playback-start-symbolic", "success"
    if j["enabled"]:
        return "enabled (inactive)", "media-playback-pause-symbolic", "warning"
    return "stopped", "media-playback-stop-symbolic", "dim-label"


