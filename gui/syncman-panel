# ── backend helpers ──────────────────────────────────────────────────────────

def find_cli():
    for c in (shutil.which("syncman"),
              os.path.expanduser("~/.local/bin/syncman"),
              os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "bin", "syncman")):
        if c and os.path.exists(c):
            return os.path.realpath(c)
    return None


def run(cmd, timeout=20):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except subprocess.TimeoutExpired:
        return 1, "", "timeout"
    except Exception as e:  # noqa: BLE001
        return 1, "", str(e)


def conf_get(key, default):
    try:
        with open(CONF_FILE) as fh:
            for line in fh:
                if line.startswith(f"{key}="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return default


def conf_set(key, value):
    os.makedirs(CONF_DIR, exist_ok=True)
    lines, found = [], False
    try:
        with open(CONF_FILE) as fh:
            lines = fh.readlines()
    except OSError:
        pass
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = f"{key}={value}\n"
            found = True
    if not found:
        lines.append(f"{key}={value}\n")
    with open(CONF_FILE, "w") as fh:
        fh.writelines(lines)


def saved_geometry():
    """(width, height, maximized) from window.json, else the default."""
    try:
        with open(WINDOW_FILE) as fh:
            d = json.load(fh)
        return (max(int(d["width"]), MIN_SIZE[0]), max(int(d["height"]), MIN_SIZE[1]),
                bool(d.get("maximized")))
    except (OSError, ValueError, KeyError, TypeError):
        return DEFAULT_SIZE[0], DEFAULT_SIZE[1], False


def remember_geometry(window):
    """GTK 4 tracks the user's resizing in the default size, and keeps the
    un-maximized one while maximized."""
    width, height = window.get_default_size()
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(WINDOW_FILE, "w") as fh:
            json.dump({"width": width, "height": height,
                       "maximized": window.is_maximized()}, fh)
    except OSError:
        pass


