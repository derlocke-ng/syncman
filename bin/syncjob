#!/usr/bin/env bash
# syncjob — worker for one syncman job: bidirectional pair-wise folder sync
# usage: syncjob <job-name> [--once]
#
# Job file format ($JOBS_DIR/<name>.job), one pair per line:
#   /path/to/source :: /path/to/destination
# Sync semantics: rsync -a --update in both directions — newer files win,
# nothing is ever deleted. Runs in a simple interval loop (no inotify needed;
# an unchanged tree costs rsync almost nothing).
set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/syncman"
CONF="$CONF_DIR/syncman.conf"

conf_get() { # key default
    local v=""
    [[ -f $CONF ]] && v="$(grep -E "^$1=" "$CONF" 2>/dev/null | head -1 | cut -d= -f2-)"
    echo "${v:-$2}"
}

JOBS_DIR="$(conf_get JOBS_DIR "$CONF_DIR/jobs")"
JOBS_DIR="${JOBS_DIR/#\~/$HOME}"
INTERVAL="$(conf_get INTERVAL 30)"

JOB="${1:-}"
[[ -n $JOB ]] || { echo "usage: syncjob <job-name> [--once]" >&2; exit 1; }
ONCE=0; [[ "${2:-}" == "--once" ]] && ONCE=1

JOB_FILE="$JOBS_DIR/$JOB.job"
[[ -f $JOB_FILE ]] || { echo "error: no such job file: $JOB_FILE" >&2; exit 1; }

# parse " :: " separated pairs (spaces in paths are fine, no quoting needed).
# Re-read before every pass: the job file is edited while the service runs
# (the panel appends a pair), and a pair that only counted after a restart
# looked like it had been ignored. `read` also takes a last line with no
# trailing newline, which an editor can leave behind.
SRC=(); DST=()
read_pairs() {
    local line
    SRC=(); DST=()
    while IFS= read -r line || [[ -n $line ]]; do
        line="${line%%#*}"
        [[ $line == *" :: "* ]] || continue
        SRC+=("$(echo "${line%% :: *}" | sed 's/^ *//;s/ *$//')")
        DST+=("$(echo "${line##* :: }" | sed 's/^ *//;s/ *$//')")
    done < "$JOB_FILE"
}
read_pairs
[[ ${#SRC[@]} -gt 0 ]] || { echo "error: no pairs in $JOB_FILE" >&2; exit 1; }
echo "syncjob '$JOB': ${#SRC[@]} pair(s), interval ${INTERVAL}s"
NPAIRS=${#SRC[@]}

sync_all() {
    local i
    for i in "${!SRC[@]}"; do
        if [[ ! -d "${SRC[$i]}" ]]; then
            echo "warning: source missing, skipping pair: ${SRC[$i]}" >&2
            continue
        fi
        mkdir -p "${DST[$i]}"
        # bidirectional, newer wins, never deletes
        rsync -a --update "${SRC[$i]}/" "${DST[$i]}/"
        rsync -a --update "${DST[$i]}/" "${SRC[$i]}/"
    done
}

sync_all
(( ONCE )) && exit 0

# hybrid trigger: with inotifywait (optional, e.g. via brew) changes sync
# instantly and the interval is just a safety ceiling; without it we poll.
HAVE_INOTIFY=0
command -v inotifywait >/dev/null 2>&1 && HAVE_INOTIFY=1
(( HAVE_INOTIFY )) && echo "inotifywait found — syncing instantly on changes"

wait_for_change() {
    if (( HAVE_INOTIFY )); then
        local watch=("$JOB_FILE") d      # the job file too: a new pair syncs at once
        for d in "${SRC[@]}" "${DST[@]}"; do [[ -d $d ]] && watch+=("$d"); done
        [[ ${#watch[@]} -gt 0 ]] || { sleep "$INTERVAL"; return; }
        # returns on the first event or after $INTERVAL — whichever comes first
        inotifywait -r -qq -t "$INTERVAL" \
            -e modify,create,move,close_write,attrib,delete "${watch[@]}" 2>/dev/null || true
    else
        sleep "$INTERVAL"
    fi
}

while true; do
    wait_for_change
    read_pairs
    if (( ${#SRC[@]} != NPAIRS )); then
        echo "job file changed: now ${#SRC[@]} pair(s)"
        NPAIRS=${#SRC[@]}
    fi
    sync_all
done
